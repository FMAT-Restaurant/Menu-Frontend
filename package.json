{
  "name": "menu-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@12.1.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=12.1.0 <13"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode demo --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "dev:federation": "vite build && vite preview",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --ci --runInBand --coverage",
    "test:e2e": "playwright test",
    "test:e2e:demo": "playwright test --config playwright.demo.config.ts"
  },
  "dependencies": {
    "axios": "1.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.0",
    "@babel/preset-typescript": "^7.27.0",
    "@eslint/js": "10.0.1",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.2.1",
    "babel-jest": "30.5.2",
    "dependency-cruiser": "^18.7.2",
    "eslint": "10.14.0",
    "globals": "^17.14.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "ts-morph": "^28.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.6"
  }
}
