# Copia este archivo como .env y ajusta los valores. .env no se versiona ni entra a la imagen Docker.

# Puerto local del contenedor (docker compose).
FRONTEND_PORT=4173

# Configuración en runtime del contenedor (/runtime-config.js → window.MENU_CONFIG).
# Vacías = rutas relativas al mismo origen (/api/v1/menu y /api/v1).
# API_BASE_URL debe terminar en /api/v1/menu. Si apuntan a otro origen, el backend debe exponer ETag por CORS.
# Los E2E contra Docker esperan ambas vacías.
API_BASE_URL=
INVENTORY_API_BASE_URL=

# Destino del proxy /api/v1 en desarrollo (npm run dev).
MENU_API_PROXY_TARGET=http://127.0.0.1:8080

# Playwright contra un servidor ya levantado (por ejemplo, Docker).
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:4173
# PLAYWRIGHT_USE_EXTERNAL_SERVER=true
